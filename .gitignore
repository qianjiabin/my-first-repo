# ---- 操作系统生成的垃圾文件 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 编辑器 / IDE 配置 ----
.vscode/
.idea/
*.swp
*.swo

# ---- 绝对不能上传的隐私文件 ----
.env
.env.local
.env.*.local
*.pem
*.key
id_rsa
id_ed25519
secrets.json

# ---- 依赖与缓存（体积巨大，绝不能传） ----
node_modules/
__pycache__/
*.pyc
dist/
build/
.venv/
venv/

# ---- 日志与临时文件 ----
*.log
*.tmp

# ---- Visual Studio / C# / .NET 工程 ----
# Visual Studio 用户级缓存（每台机器都不同，绝不能传）
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
.vscode/

# 编译产物（exe/dll/pdb 体积巨大，从仓库重新生成）
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild[Ll]og.*
*.dll
*.exe
*.pdb
*.cachefile

# NuGet 还原目录
packages/
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Rider / ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# .NET Core / 5+ 工程特有
[Tt]est[Rr]esult*/
TestResults/
*.coverage
*.coveragexml
